# system.prop — GameUnlocker global system properties
#
# POLICY: Only set properties that are:
#   (a) Safe to apply to ALL processes (no identity-revealing props)
#   (b) Performance-positive and not device-specific
#   (c) Cannot conflict with per-app spoofing done by the Zygisk module
#
# Per-app spoofing of ro.product.* / ro.build.fingerprint is handled
# exclusively by SysPropHook.cpp + Spoofer.cpp via bytehook interception.
# Do NOT set those here — they would leak spoofed identity globally to
# banking apps, Play Services, and other sensitive processes.
# =============================================================================

# ---------------------------------------------------------------------------
# SurfaceFlinger — refresh rate / display
# Enables content-based refresh rate detection so SurfaceFlinger can
# automatically switch to the display's highest supported refresh rate
# when a game is rendering at that cadence (e.g. 90/120 fps).
# ---------------------------------------------------------------------------
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.protected_contents=true

# ---------------------------------------------------------------------------
# HWUI / Rendering Pipeline
# debug.hwui.renderer=skiavk: forces Skia-Vulkan backend for hardware canvas
# operations. On Adreno and Mali, Vulkan has lower driver overhead than GLES.
# debug.hwui.use_hint_manager: enables ADPF performance hints from UI thread.
# These apply to the system compositor, not individual apps.
# ---------------------------------------------------------------------------
debug.hwui.renderer=skiavk
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=66
debug.egl.hw=1

# ---------------------------------------------------------------------------
# Game FPS — QTI Game SDK props
# These are read by the Qualcomm Game SDK (com.qualcomm.qti.Performance.jar)
# and by vendor game services on MIUI/HyperOS/ColorOS to determine the
# target frame rate to report to the Game Frame Rate HAL.
# Setting 120 here provides the highest baseline; individual games that
# internally cap at 60/90 are unaffected (they don't read this prop).
# ---------------------------------------------------------------------------
debug.vendor.qti.game.fps=120
persist.vendor.qti.game.fps=120

# ---------------------------------------------------------------------------
# Build type — safe global override
# Some games gate high-FPS mode on ro.build.type=user. Setting it globally
# here (rather than in post-fs-data where it requires resetprop) ensures
# the value is seen by any process that reads it from the property service
# before Zygote has been patched by the Zygisk hook.
# ---------------------------------------------------------------------------
ro.build.type=user
ro.build.tags=release-keys

# ---------------------------------------------------------------------------
# ART / JIT tuning
# usejitprofiles: persist JIT profiles across sessions → faster cold starts
# usejit: enable JIT (should be on by default, explicit here for safety)
# ---------------------------------------------------------------------------
dalvik.vm.usejitprofiles=true
dalvik.vm.usejit=true

# ---------------------------------------------------------------------------
# Dalvik VM heap — high-end device profile
# These match the heap parameters of flagship devices (e.g. Galaxy S24 Ultra).
# Games query ro.dalvik.vm.heapsize via reflection to determine safe allocation
# limits. Larger values prevent OOM-kills during asset streaming.
# ---------------------------------------------------------------------------
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# ---------------------------------------------------------------------------
# Disable unnecessary debug overhead
# ---------------------------------------------------------------------------
debug.atrace.tags.enableflags=0
debug.sf.recomputecrop=0
debug.vulkan.layers=
